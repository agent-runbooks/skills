{
  "type": "object",
  "description": "With status done, every field but reason is set and reason is null. With failed or blocked, reason is one line and the other fields are null.",
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "done",
        "failed",
        "blocked"
      ]
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "warnings": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "status",
    "reason",
    "warnings"
  ],
  "additionalProperties": false
}
